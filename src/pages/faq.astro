---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqs } from '../data/content';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title="よくある質問" description="戦略MG研修・セミナーに関するよくある質問。">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <PageHero en="FAQ" title="よくある質問" lead="ご不明な点は、お気軽にお問い合わせください。" />
  <section class="section">
    <div class="container-x max-w-3xl grid gap-3">
      {faqs.map((f) => (
        <details class="card group !p-0">
          <summary class="flex cursor-pointer list-none items-start gap-3 p-5 font-bold text-night-900">
            <span class="text-dawn-500">Q.</span><span class="flex-1">{f.q}</span><span class="transition group-open:rotate-45 text-dawn-500">＋</span>
          </summary>
          <p class="px-5 pb-5 pl-11 text-sm text-muted">{f.a}</p>
        </details>
      ))}
      <p class="mt-8 text-center text-sm">解決しない場合は <a href="/contact/" class="font-bold text-dawn-600 underline underline-offset-4">お問い合わせフォーム</a> へ。</p>
    </div>
  </section>
  <CtaBand />
</Base>
