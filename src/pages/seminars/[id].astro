---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { formatRange, getSeminar, isOpen } from '../../lib/seminars';

export const prerender = false;
const s = await getSeminar(Astro.params.id ?? '');
if (!s) return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300');

const rows: [string, string][] = [
  ['日時', `${formatRange(s)}　${s.time}`],
  ['開催地', s.area],
  ['会場', [s.venue, s.address].filter(Boolean).join('　')],
  ['定員', s.capacity ? `${s.capacity}名（定員になり次第締め切り）` : ''],
  ['参加費', s.fee],
  ['対象', s.targets.join('・')],
  ['持ち物', '筆記用具・電卓'],
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: s.title,
  startDate: s.start,
  endDate: s.end ?? s.start,
  eventAttendanceMode: s.area === 'オンライン' ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
  location: s.area === 'オンライン' ? { '@type': 'VirtualLocation', url: Astro.url.href } : { '@type': 'Place', name: s.venue || s.area, address: s.address || s.area },
  description: s.summary,
};
---
<Base title={`${s.title}（${s.area}）`} description={`${formatRange(s)} ${s.area}開催。${s.summary}`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <PageHero en="Seminar" title={s.title} lead={`${s.area}｜${formatRange(s)}`} crumbs={[{ href: '/seminars/', label: 'セミナー日程' }]} />
  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div>
        {s.isSample && <p class="mb-6 rounded-xl bg-dawn-50 p-4 text-sm text-dawn-600">※サンプルの日程です。</p>}
        <p class="text-lg">{s.summary}</p>
        <div class="prose-ja mt-8">
          <h2>セミナー概要</h2>
          <table><tbody>{rows.filter(([, v]) => v).map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table>
          <h2>当日の流れ（例）</h2>
          <ol>
            <li>オリエンテーション・ルール説明</li>
            <li>経営ゲーム（意思決定と市場での競争）</li>
            <li>決算（損益計算書・貸借対照表の作成）</li>
            <li>振り返りと次期の戦略づくり</li>
          </ol>
          <h2>キャンセルについて</h2>
          <p>開催日の7日前までのキャンセルは無料です。詳しくは<a href="/tokushoho/">特定商取引法に基づく表記</a>をご確認ください。</p>
        </div>
      </div>
      <aside class="lg:sticky lg:top-28 h-fit card p-8">
        <p class="text-sm text-muted">{s.kind}</p>
        <p class="mt-1 font-display text-xl font-bold text-night-900">{formatRange(s)}</p>
        <p class="text-sm">{s.time}</p>
        <p class="mt-4 text-sm">参加費：{s.fee}</p>
        {isOpen(s) ? (
          <>
            <a href={`/apply/?seminar=${s.id}`} class="btn-primary mt-6 w-full !py-4 text-base">このセミナーに申し込む</a>
            {s.status === '残りわずか' && <p class="mt-3 text-center text-sm font-bold text-dawn-600">残席わずかです</p>}
          </>
        ) : (
          <p class="mt-6 rounded-xl bg-black/5 p-4 text-center font-bold text-muted">{s.status}</p>
        )}
        <a href="/contact/" class="btn-outline mt-3 w-full">質問する</a>
      </aside>
    </div>
  </section>
</Base>
