---
import { footerNav, site, trademarkNote } from '../data/site';
import Logo from './Logo.astro';
import LineBanner from './LineBanner.astro';
---
<LineBanner />
<footer class="bg-night-950 text-white/70">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1fr_2fr]">
    <div>
      <Logo light />
      <p class="mt-4 text-sm">{site.address}</p>
      <p class="text-sm">Mail：{site.email}</p>
    </div>
    <nav aria-label="フッターメニュー">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-3">
        {footerNav.map((n) => <li><a href={n.href} class="hover:text-dawn-300">{n.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x py-6 text-xs">
      <p>{trademarkNote}</p>
      <p class="mt-1">&copy; {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>
